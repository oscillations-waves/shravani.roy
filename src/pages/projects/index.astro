---
import { getCollection } from "astro:content";

import PageLayout from "../../layouts/PageLayout.astro";
import TopLayout from "../../layouts/TopLayout.astro";
import BottomLayout from "../../layouts/BottomLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { PROJECTS } from "@/consts";
import { toValidDate } from "@/lib/utils";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort(
    (a, b) =>
      toValidDate(b.data.date, `${b.collection}/${b.id}.date`).getTime() -
      toValidDate(a.data.date, `${a.collection}/${a.id}.date`).getTime()
  );
---

<PageLayout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <div class="min-h-screen bg-[#FDFAF2] text-neutral-700 dark:bg-black dark:text-white">
  <TopLayout>
    <div>
      <h1 class="mt-2 text-3xl font-semibold text-neutral-800 dark:text-white">
        {PROJECTS.TITLE}
      </h1>

      <div class="mt-1">
        {PROJECTS.DESCRIPTION}
      </div>
    </div>
  </TopLayout>

  <BottomLayout>
    <section class="space-y-4">
      {projects.length > 0 ? (
        <ul class="space-y-4">
          {projects.map((project) => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-neutral-800/70 dark:text-white/70">
          No projects found.
        </p>
      )}
    </section>
  </BottomLayout>
  </div>
</PageLayout>