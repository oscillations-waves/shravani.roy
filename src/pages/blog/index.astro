---
import { getCollection } from "astro:content";

import PageLayout from "../../layouts/PageLayout.astro";
import TopLayout from "../../layouts/TopLayout.astro";
import BottomLayout from "../../layouts/BottomLayout.astro";
import SearchCollection from "@components/SearchCollection.astro";
import { BLOG } from "@/consts";
import { toValidDate } from "@/lib/utils";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      toValidDate(b.data.date, `${b.collection}/${b.id}.date`).getTime() -
      toValidDate(a.data.date, `${a.collection}/${a.id}.date`).getTime()
  );

const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort(
  (a, b) => a.localeCompare(b)
);

const estimated_initial_size =
  28 + posts.length * 158 + Math.max(posts.length - 1, 0) * 12;
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <TopLayout>
    <div>
      <h1 class="mt-2 text-3xl font-semibold text-black dark:text-white">
        {BLOG.TITLE}
      </h1>

      <div class="mt-1">
        {BLOG.DESCRIPTION}
      </div>
    </div>
  </TopLayout>

  <BottomLayout>
    <div
      id="search-collection-wrapper"
      class="animate"
      style={`min-height: ${estimated_initial_size}px`}
    >
      <SearchCollection
        entry_name="posts"
        tags={tags}
        data={posts}
      />
    </div>
  </BottomLayout>
</PageLayout>