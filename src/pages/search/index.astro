---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import TopLayout from "../../layouts/TopLayout.astro";
import BottomLayout from "../../layouts/BottomLayout.astro";
import Search from "@components/Search.astro";
import { SEARCH } from "@/consts";

type SearchEntry = CollectionEntry<"blog"> | CollectionEntry<"projects">;

const dateToTime = (value: unknown, label: string): number => {
  if (value instanceof Date) {
    const time = value.getTime();

    if (!Number.isNaN(time)) {
      return time;
    }
  }

  if (typeof value === "string" || typeof value === "number") {
    const time = new Date(value).getTime();

    if (!Number.isNaN(time)) {
      return time;
    }
  }

  throw new Error(`Invalid date for ${label}: ${String(value)}`);
};

const posts = (await getCollection("blog")).filter((post) => !post.data.draft);

const projects = (await getCollection("projects")).filter(
  (project) => !project.data.draft
);

const data: SearchEntry[] = [...posts, ...projects].sort(
  (a, b) =>
    dateToTime(b.data.date, `${b.collection}/${b.slug}.date`) -
    dateToTime(a.data.date, `${a.collection}/${a.slug}.date`)
);
---

<PageLayout title={SEARCH.TITLE} description={SEARCH.DESCRIPTION}>
  <TopLayout>
    <div class="page-heading">
      {SEARCH.TITLE}
    </div>
  </TopLayout>

  <BottomLayout>
    <Search data={data} placeholderText="Search posts and projects..." />
  </BottomLayout>
</PageLayout>
