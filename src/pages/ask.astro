---
import PageLayout from "../layouts/PageLayout.astro";
import AskMyBlogChat from "@/components/AskMyBlogChat";

const apiUrl =
  import.meta.env.PUBLIC_API_URL ?? "https://roybonny-askmyblog.hf.space/api/ask";
---

<PageLayout title="Ask My Blog" description="Ask anything about Shravani's blog — powered by AI.">
  <div class="container max-w-2xl mx-auto px-4 py-12">
    <h1 class="text-2xl font-semibold mb-2">Ask my blog</h1>
    <p class="text-zinc-500 dark:text-zinc-400 text-sm mb-8">
      Ask anything about my posts — topics, ideas, details. Answers come from the blog content only.
    </p>
    <AskMyBlogChat apiUrl={apiUrl} client:load />
  </div>
</PageLayout>
