---
import { getCollection, type CollectionEntry } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import PhotoGallery from "@components/PhotoGallery.astro";
import Portrait from "@components/Portrait.astro";
import { SITE, SOCIALS } from "@/consts";
import { formatDate, toValidDate, withBase } from "@/lib/utils";

type HomeEntry = CollectionEntry<"blog"> | CollectionEntry<"projects">;

const recent = <T extends HomeEntry>(entries: T[], limit: number): T[] =>
  entries
    .filter((entry) => !entry.data.draft)
    .sort(
      (a, b) =>
        toValidDate(b.data.date, `${b.collection}/${b.id}.date`).getTime() -
        toValidDate(a.data.date, `${a.collection}/${a.id}.date`).getTime()
    )
    .slice(0, limit);

const posts = recent(
  await getCollection("blog", ({ data }) => data.tags.includes("technology")),
  3,
);
const projects = recent(
  await getCollection("projects", ({ id }) => id !== "coming-soon"),
  2,
);
const instagram = SOCIALS.find(({ NAME }) => NAME === "Instagram");
---

<PageLayout title="Home" description="Software engineering projects, tech writing, and a photo gallery by Shravani Roy.">
  <div class="home-content">
    <section class="intro" aria-labelledby="home-title">
      <div>
        <p class="eyebrow">{SITE.SHORT_NAME}</p>
        <h1 id="home-title">I build backend <em>systems.</em></h1>
        <p class="intro-note">Building systems. Collecting stories. Chasing quiet.</p>
        <p class="intro-copy">
          I&rsquo;m a senior software engineer at N-able, where I build Go
          services for identity and access management. I write about technology
          and the things I learn along the way. Away from my desk, I love taking
          photographs and getting lost in a good book.
        </p>
        <div class="intro-links">
          <a class="button" href={projects.length > 0 ? "#selected-work" : withBase("/projects")}>
            Explore my work <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="text-link" href={withBase("/blog")}>Read my blog</a>
        </div>
      </div>

      <Portrait daisies />
    </section>

    {projects.length > 0 && (
      <section id="selected-work" class="home-section" aria-labelledby="projects-title">
        <div class="section-heading">
          <h2 id="projects-title">Selected work</h2>
          <a class="text-link" href={withBase("/projects")}>
            All projects <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <ul class="project-list" role="list">
          {projects.map((project) => (
            <li class="project">
              <h3>{project.data.title}</h3>
              <p>{project.data.summary}</p>
              <ul class="project-tags" aria-label="Technologies" role="list">
                {project.data.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              <a class="text-link" href={withBase(`/projects/${project.id}`)}>
                View project <span class="sr-only">{project.data.title}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {posts.length > 0 && (
      <section class="home-section" aria-labelledby="writing-title">
        <div class="section-heading">
          <h2 id="writing-title">Tech writing</h2>
          <a class="text-link" href={withBase("/blog")}>
            All posts <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <ul class="post-list" role="list">
          {posts.map((post) => {
            const dateSource = `${post.collection}/${post.id}.date`;
            const date = toValidDate(post.data.date, dateSource);

            return (
              <li>
                <a class="post-link" href={withBase(`/blog/${post.id}`)}>
                  <time datetime={date.toISOString()}>
                    {formatDate(date, dateSource)}
                  </time>
                  <div>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.summary}</p>
                  </div>
                  <span class="post-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <section id="gallery" class="home-section" aria-labelledby="gallery-title">
      <div class="section-heading">
        <h2 id="gallery-title">Gallery</h2>
        {instagram && (
          <a class="text-link" href={instagram.HREF}>
            Instagram <span aria-hidden="true">&nearr;</span>
          </a>
        )}
      </div>
      <PhotoGallery viewerId="home-gallery-viewer" />
    </section>
  </div>
</PageLayout>

<style>
  .home-content {
    width: 100%;
    max-width: 64rem;
    margin-inline: auto;
    padding: 4rem 1.25rem 1.5rem;
  }

  .home-content a:focus-visible {
    outline: 2px solid var(--site-accent);
    outline-offset: 4px;
  }

  .intro {
    display: grid;
    align-items: center;
    justify-items: start;
    gap: 2.75rem;
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .eyebrow,
  .post-link time {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    color: var(--site-accent);
  }

  .eyebrow {
    font-size: 0.9375rem;
    letter-spacing: 0.035em;
  }

  .post-link time {
    text-transform: uppercase;
  }

  h1,
  h2,
  .project h3,
  .post-link h3 {
    font-family: var(--site-heading-font);
    font-weight: 400;
  }

  h1 {
    margin-block: 0.65rem 1.35rem;
    font-size: clamp(2.65rem, 6.4vw, 5rem);
    line-height: 0.99;
    letter-spacing: -0.055em;
  }

  h1 em {
    display: block;
    color: var(--site-accent);
  }

  .intro-note {
    color: var(--site-accent);
    font-family: var(--site-heading-font);
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    line-height: 1.45;
  }

  .intro-copy {
    max-width: 42ch;
    margin-top: 0.75rem;
    color: var(--site-muted);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .intro-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.4rem;
    margin-top: 1.65rem;
  }

  .button {
    display: inline-flex;
    gap: 0.8rem;
    align-items: center;
    padding: 0.65rem 1.15rem;
    border-radius: 999px;
    background: var(--site-accent);
    color: var(--site-paper);
  }

  .button:hover {
    background: var(--site-ink);
  }

  .text-link {
    color: var(--site-accent);
    text-decoration: underline;
    text-underline-offset: 0.27em;
    text-decoration-color: color-mix(in srgb, var(--site-accent) 50%, transparent);
  }

  .text-link:hover {
    text-decoration-color: currentColor;
  }

  .home-section {
    padding-block: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--site-rule);
  }

  #selected-work,
  #gallery {
    scroll-margin-top: 4rem;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.2rem;
  }

  h2 {
    font-size: clamp(1.85rem, 4vw, 2.65rem);
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .project-list {
    display: grid;
    gap: 1rem;
  }

  .project {
    padding: clamp(1.35rem, 4vw, 2.5rem);
    border: 1px solid var(--site-rule);
    border-radius: 0.85rem;
    background: var(--site-wash);
  }

  .project h3 {
    font-size: clamp(1.65rem, 3.15vw, 2.5rem);
    line-height: 1.1;
  }

  .project p {
    max-width: 59ch;
    margin-top: 0.7rem;
    color: var(--site-muted);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block: 1.2rem;
  }

  .project-tags li {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--site-rule);
    border-radius: 999px;
    color: var(--site-accent);
    font-size: 0.78rem;
  }

  .post-list {
    border-block: 1px solid var(--site-rule);
  }

  .post-list li + li {
    border-top: 1px solid var(--site-rule);
  }

  .post-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.4rem 0.75rem;
    padding: 1.15rem 0.35rem;
  }

  .post-link:hover {
    background: var(--site-wash);
  }

  .post-link time {
    grid-column: 1 / -1;
  }

  .post-link h3 {
    font-size: clamp(1.2rem, 2.65vw, 1.6rem);
    line-height: 1.25;
  }

  .post-link p {
    margin-top: 0.35rem;
    color: var(--site-muted);
  }

  .post-arrow {
    color: var(--site-accent);
    font-size: 1.18rem;
  }

  #gallery > .section-heading:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 42rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .post-link {
      grid-template-columns: 7.5rem minmax(0, 1fr) auto;
      gap: 1rem;
      padding-inline: 0.75rem;
    }

    .post-link time {
      grid-column: auto;
      margin-top: 0.4rem;
    }
  }
</style>
