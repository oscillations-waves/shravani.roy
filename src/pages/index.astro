---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import PageLayout from "../layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import StackCard from "@components/StackCard.astro";
import { SITE, SOCIALS } from "@/consts";
import { toValidDate, withBase } from "@/lib/utils";

type BlogEntry = CollectionEntry<"blog">;
type ProjectEntry = CollectionEntry<"projects">;

const recent = <T extends BlogEntry | ProjectEntry>(entries: T[], limit = 3): T[] =>
  entries
    .filter((entry) => !entry.data.draft)
    .sort(
      (a, b) =>
        toValidDate(b.data.date, `${b.collection}/${b.id}.date`).getTime() -
        toValidDate(a.data.date, `${a.collection}/${a.id}.date`).getTime()
    )
    .slice(0, limit);

const posts = recent((await getCollection("blog")) as BlogEntry[], 8);
const projects = recent((await getCollection("projects")) as ProjectEntry[]);

const stack = [
  {
    text: "Astro",
    icon: "astro",
    href: "https://astro.build",
  },
  {
    text: "JavaScript",
    icon: "javascript",
    href: "https://www.javascript.com",
  },
  {
    text: "TypeScript",
    icon: "typescript",
    href: "https://www.typescriptlang.org",
  },
  {
    text: "Tailwind",
    icon: "tailwind",
    href: "https://tailwindcss.com",
  },
];
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>
  <main class="relative min-h-screen overflow-hidden bg-transparent text-black dark:bg-black dark:text-white">
    <!-- Subtle radial accent (kept only for dark mode glow; light mode lets the body gradient breathe). -->
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 dark:bg-[radial-gradient(circle_at_top,_rgba(120,119,198,0.25),_transparent_35%),linear-gradient(to_bottom,_#020617,_#000000)]"
    >
    </div>

    <!-- HERO -->
    <section class="relative flex min-h-screen w-full items-center justify-center px-5">
      <div class="absolute inset-0 top-1/4 overflow-hidden">
        <div
          class="absolute left-1/2 top-0 aspect-square min-h-[100vh] w-[250vw] -translate-x-1/2 rounded-full bg-gradient-to-b from-black/10 from-0% to-transparent to-5% p-[1px] dark:from-white/20"
        >
          <div class="flex h-full w-full justify-center overflow-hidden rounded-full bg-transparent p-[1px] dark:bg-black">
            <div class="h-20 w-full rounded-full bg-neutral-900/10 blur-3xl dark:bg-white/25"></div>
          </div>
        </div>
      </div>

      <div class="relative flex h-full w-full items-center justify-center">
        <div class="p-5 text-center">
          <p class="text-lg font-semibold opacity-75 md:text-xl lg:text-2xl">
            Hello, I am ...
          </p>

          <h1 class="mt-2 text-2xl font-bold text-black dark:text-white md:text-3xl lg:text-4xl">
            Shravani
          </h1>

          <p class="mt-2 text-sm opacity-75 md:text-base lg:text-lg">
            Building systems. Collecting stories. Chasing quiet.
          </p>

          <div class="mt-5 flex flex-wrap justify-center gap-4">
            <a
              href={withBase("/blog")}
              class="rounded bg-black px-4 py-2 text-xs text-white hover:opacity-75 dark:bg-white dark:text-black md:text-sm lg:text-base"
            >
              Read my blog
            </a>

            <a
              href={withBase("/projects")}
              class="rounded border border-black/25 px-4 py-2 text-xs hover:bg-black/5 dark:border-white/25 hover:dark:bg-white/15 md:text-sm lg:text-base"
            >
              View my work
            </a>
          </div>
        </div>
      </div>

      <!-- Scroll-to-explore indicator -->
      <a
        href="#about"
        aria-label="Scroll down to explore"
        class="group absolute bottom-8 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-2 text-xs uppercase tracking-widest text-black/60 transition-colors hover:text-black dark:text-white/60 dark:hover:text-white"
      >
        <span>Scroll to explore</span>
        <svg
          class="size-5 animate-bounce"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 5v14" />
          <path d="m19 12-7 7-7-7" />
        </svg>
      </a>
    </section>

    <div id="about" class="relative bg-transparent dark:bg-black">
      <div class="mx-auto max-w-screen-sm space-y-24 p-5 pb-16">
        <!-- Mission statement -->
        <section aria-label="About this blog" class="flex flex-col items-center gap-6 text-center">
          <span class="h-px w-16 bg-black/20 dark:bg-white/20"></span>
          <p class="max-w-prose text-base italic text-black/80 md:text-lg dark:text-white/80">
            This blog is a little corner of the internet where I write about
            technology, cinema, ideas, observations, and the things that stay
            with me long after the screen goes dark.
          </p>
          <span class="h-px w-16 bg-black/20 dark:bg-white/20"></span>
        </section>

        <!-- Blog Preview Section: horizontal sliding carousel -->
        <section>
          <div class="space-y-4">
            <div class="flex justify-between">
              <p class="font-semibold text-black dark:text-white">
                Recent posts
              </p>

              <a
                href={withBase("/blog")}
                class="group flex w-fit items-center gap-1 underline decoration-black/25 decoration-[.5px] underline-offset-2 hover:decoration-black dark:decoration-white/50 dark:hover:decoration-white"
              >
                <span class="text-black/75 group-hover:text-black dark:text-white/75 group-hover:dark:text-white">
                  All posts
                </span>
              </a>
            </div>

            <div class="-mx-5">
              <ul
                class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-5 pb-4 [scrollbar-width:thin]"
              >
                {posts.map((post) => (
                  <li class="snap-start shrink-0 w-72 sm:w-80">
                    <ArrowCard entry={post} />
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <!-- Tech Stack Section -->
        <section>
          <div class="space-y-4">
            <p class="font-semibold text-black dark:text-white">
              Website built with
            </p>

            <div class="mt-5 flex flex-wrap items-center gap-2">
              {stack.map((item) => (
                <StackCard
                  text={item.text}
                  icon={item.icon}
                  href={item.href}
                />
              ))}
            </div>

            <p>
              Built as a fast, content-focused Astro site with TypeScript and
              Tailwind.
            </p>
          </div>
        </section>

        <!-- Project Preview Section -->
        <section>
          <div class="space-y-4">
            <div class="flex justify-between">
              <p class="font-semibold text-black dark:text-white">
                Recent projects
              </p>

              <a
                href={withBase("/projects")}
                class="group flex w-fit items-center gap-1 underline decoration-black/25 decoration-[.5px] underline-offset-2 hover:decoration-black dark:decoration-white/50 dark:hover:decoration-white"
              >
                <span class="text-black/75 group-hover:text-black dark:text-white/75 group-hover:dark:text-white">
                  All projects
                </span>
              </a>
            </div>

            <ul class="space-y-4">
              {projects.map((project) => (
                <li>
                  <ArrowCard entry={project} />
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- Let's Connect CTA -->
        <section class="flex flex-col items-center gap-4 text-center">
          <p class="font-semibold text-black dark:text-white text-xl md:text-2xl">
            Let&rsquo;s connect
          </p>
          <p class="max-w-prose">
            I&rsquo;m always up for a good conversation about technology,
            cinema, books, or anything that&rsquo;s been on your mind.
          </p>
          <a
            href={withBase("/about")}
            class="mt-2 inline-flex items-center gap-2 rounded bg-black px-5 py-2.5 text-sm text-white hover:opacity-75 dark:bg-white dark:text-black md:text-base"
          >
            More about me
            <svg
              class="size-4"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </section>
      </div>
    </div>
  </main>
</PageLayout>