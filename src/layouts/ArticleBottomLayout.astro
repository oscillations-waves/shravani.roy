---
import { type CollectionEntry, getCollection, render } from "astro:content"
import { toValidDate, withBase } from "@/lib/utils"

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">
}

// Get the requested entry
const { entry } = Astro.props
const { collection } = entry
const Content = Astro.slots.has("default") ? undefined : (await render(entry)).Content

// Get the next and prev entries (modulo to wrap index)
const items = (await getCollection(collection))
  .filter(post => !post.data.draft)
  .sort(
    (a, b) =>
      toValidDate(b.data.date, `${b.collection}/${b.id}.date`).getTime() -
      toValidDate(a.data.date, `${a.collection}/${a.id}.date`).getTime()
  )
const index = items.findIndex(x => x.id === entry.id)
const prev = items[(index - 1 + items.length) % items.length]
const next = items[(index + 1) % items.length]
---

<article>
  <slot />
  {Content && <Content />}
</article>

<nav class="article-nav grid grid-cols-1 gap-4 sm:grid-cols-2" aria-label="Article navigation">
  <a href={withBase(`/${prev.collection}/${prev.id}`)} class="group">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="rotate-180"
      aria-hidden="true"
    >
      <line x1="5" y1="12" x2="19" y2="12" class="translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100" />
      <polyline points="12 5 19 12 12 19" class="transition-all duration-300 ease-in-out group-hover:translate-x-1" />
    </svg>
    <div>
      <div class="article-nav-label">Prev</div>
      <div class="article-nav-title">{prev.data.title}</div>
    </div>
  </a>
  <a href={withBase(`/${next.collection}/${next.id}`)} class="group text-right">
    <div>
      <div class="article-nav-label">Next</div>
      <div class="article-nav-title">{next.data.title}</div>
    </div>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="5" y1="12" x2="19" y2="12" class="translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100" />
      <polyline points="12 5 19 12 12 19" class="transition-all duration-300 ease-in-out group-hover:translate-x-1" />
    </svg>
  </a>
</nav>

<style>
  .article-nav {
    border-top: 1px solid var(--site-rule);
    padding-top: 1.25rem;
  }

  .article-nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border: 1px solid var(--site-rule);
    border-radius: 0.5rem;
    padding: 1rem;
    color: var(--site-ink);
    background: var(--site-surface);
    transition: background-color 150ms ease, border-color 150ms ease;
  }

  .article-nav a:hover,
  .article-nav a:focus-visible {
    border-color: var(--site-control);
    background: var(--site-wash);
  }

  .article-nav a > div {
    flex: 1;
    min-width: 0;
  }

  .article-nav svg {
    flex: none;
    color: var(--site-accent);
  }

  .article-nav-label {
    color: var(--site-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .article-nav-title {
    margin-top: 0.35rem;
    font-family: var(--site-heading-font);
    font-size: 1.125rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
</style>
