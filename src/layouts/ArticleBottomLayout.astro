---
import { type CollectionEntry, getCollection } from "astro:content";

type Entry = CollectionEntry<"blog"> | CollectionEntry<"projects">;

type Props = {
  entry: Entry;
};

const { entry } = Astro.props as Props;
const { Content } = await entry.render();

const dateToTime = (value: unknown, label: string): number => {
  if (value instanceof Date) {
    const time = value.getTime();

    if (!Number.isNaN(time)) {
      return time;
    }
  }

  if (typeof value === "string" || typeof value === "number") {
    const time = new Date(value).getTime();

    if (!Number.isNaN(time)) {
      return time;
    }
  }

  throw new Error(`Invalid date for ${label}: ${String(value)}`);
};

const items: Entry[] =
  entry.collection === "blog"
    ? ((await getCollection("blog")) as Entry[])
        .filter((post) => !post.data.draft)
        .sort(
          (a, b) =>
            dateToTime(b.data.date, `${b.collection}/${b.slug}.date`) -
            dateToTime(a.data.date, `${a.collection}/${a.slug}.date`)
        )
    : ((await getCollection("projects")) as Entry[])
        .filter((project) => !project.data.draft)
        .sort(
          (a, b) =>
            dateToTime(b.data.date, `${b.collection}/${b.slug}.date`) -
            dateToTime(a.data.date, `${a.collection}/${a.slug}.date`)
        );

const index = items.findIndex((item) => item.slug === entry.slug);
const hasSiblings = items.length > 1 && index >= 0;
const prev = hasSiblings ? items[(index - 1 + items.length) % items.length] : undefined;
const next = hasSiblings ? items[(index + 1) % items.length] : undefined;
---

<div>
  <article>
    <Content />
  </article>

  {prev && next && (
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <a
        href={`/${prev.collection}/${prev.slug}`}
        class="group flex items-center gap-3 rounded-lg border border-black/15 p-4 hover:bg-black/5 dark:border-white/20 hover:dark:bg-white/10"
      >
        <div class="order-2 h-full w-full group-hover:text-black group-hover:dark:text-white">
          <div class="flex flex-wrap gap-2">
            <div class="text-sm uppercase">Prev</div>
          </div>
          <div class="mt-3 font-semibold text-black dark:text-white">
            {prev.data.title}
          </div>
        </div>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="order-1 rotate-180 group-hover:stroke-black group-hover:dark:stroke-white"
          aria-hidden="true"
        >
          <line x1="5" y1="12" x2="19" y2="12" class="translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100" />
          <polyline points="12 5 19 12 12 19" class="translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1" />
        </svg>
      </a>

      <a
        href={`/${next.collection}/${next.slug}`}
        class="group flex items-center gap-3 rounded-lg border border-black/15 p-4 transition-colors duration-300 ease-in-out hover:bg-black/5 dark:border-white/20 hover:dark:bg-white/10"
      >
        <div class="h-full w-full text-right group-hover:text-black group-hover:dark:text-white">
          <div class="text-sm uppercase">Next</div>
          <div class="mt-3 font-semibold text-black dark:text-white">
            {next.data.title}
          </div>
        </div>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="group-hover:stroke-black group-hover:dark:stroke-white"
          aria-hidden="true"
        >
          <line x1="5" y1="12" x2="19" y2="12" class="translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100" />
          <polyline points="12 5 19 12 12 19" class="translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1" />
        </svg>
      </a>
    </div>
  )}
</div>
