---
import { SITE, SOCIALS } from "@/consts";
import { withBase } from "@/lib/utils";

const email = SOCIALS.find(({ ICON }) => ICON === "email");
const profiles = SOCIALS.filter(({ ICON }) => ICON !== "email");
const year = new Date().getFullYear();
---

<footer id="contact" class="site-footer">
  <div class="footer-inner">
    <div class="footer-contact">
      <div>
        <h2>Drop me a note.</h2>
        <p>
          Have a project in mind, a book to recommend, or a photo to share?
          I&rsquo;d love to hear from you.
        </p>
        <div class="contact-links">
          {email && (
            <a class="email-link" href={email.HREF}>
              Email me <span aria-hidden="true">&rarr;</span>
            </a>
          )}
          <a href={withBase("/about")}>About me</a>
        </div>
      </div>

      <nav class="profiles" aria-label="Social profiles">
        <ul role="list">
          {profiles.map(({ HREF, NAME }) => (
            <li>
              <a href={HREF}>{NAME} <span aria-hidden="true">&nearr;</span></a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <small>&copy; {year} {SITE.SHORT_NAME}</small>
      <nav aria-label="Footer links">
        <a href={withBase("/legal/terms")}>Terms</a>
        <a href={withBase("/legal/privacy")}>Privacy</a>
        <a class="back-to-top" href="#top">Back to top <span aria-hidden="true">&uarr;</span></a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --footer-mark: color-mix(in srgb, var(--site-inverse-muted) 14%, transparent);

    flex: none;
    background-color: var(--site-inverse-bg);
    background-image: radial-gradient(
      circle at 88% 2.75rem,
      transparent 38px, var(--footer-mark) 39px 40px,
      transparent 41px 53px, var(--footer-mark) 54px 55px,
      transparent 56px 68px, var(--footer-mark) 69px 70px,
      transparent 71px 83px, var(--footer-mark) 84px 85px,
      transparent 86px 98px, var(--footer-mark) 99px 100px,
      transparent 101px
    );
    color: var(--site-inverse-ink);
  }

  .footer-inner {
    max-width: 64rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .footer-contact {
    display: grid;
    gap: 1.75rem 3rem;
    padding-block: clamp(2.5rem, 6vw, 4.25rem) clamp(1.75rem, 4vw, 2.75rem);
  }

  h2 {
    font-family: var(--site-heading-font);
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    letter-spacing: -0.05em;
    line-height: 1.04;
  }

  p {
    max-width: 29rem;
    margin-block: 0.8rem 1.35rem;
    color: var(--site-inverse-muted);
    font-size: 1.0625rem;
  }

  .contact-links,
  .footer-bottom,
  .footer-bottom nav,
  .profiles ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.25rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 1.5rem;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--site-inverse-muted) 55%, transparent);
    text-underline-offset: 0.25em;
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  a:focus-visible {
    outline: 2px solid var(--site-inverse-ink);
    outline-offset: 4px;
  }

  .email-link {
    min-height: 2.75rem;
    padding: 0.5rem 0.9rem;
    border-radius: 0.25rem;
    background: var(--site-inverse-ink);
    color: var(--site-inverse-bg);
    font-weight: 700;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .email-link:hover {
    background: var(--site-inverse-muted);
  }

  .profiles ul {
    font-size: 0.95rem;
  }

  .profiles span,
  .footer-bottom {
    color: var(--site-inverse-muted);
  }

  .footer-bottom {
    justify-content: space-between;
    padding-block: 0.95rem;
    border-top: 1px solid color-mix(in srgb, var(--site-inverse-muted) 30%, transparent);
    font-size: 0.875rem;
  }

  small {
    font-size: inherit;
  }

  .back-to-top {
    color: var(--site-inverse-ink);
  }

  @media (min-width: 48rem) {
    .footer-contact {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .profiles ul {
      display: grid;
      grid-template-columns: repeat(2, auto);
      gap: 0.4rem 1.5rem;
    }
  }
</style>
