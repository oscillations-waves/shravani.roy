---
type Props = {
  id?: string;
  label?: string;
  placeholderText?: string;
};

const {
  id = "search",
  label = "Search",
  placeholderText = "What are you looking for?",
} = Astro.props as Props;
---

<div class="relative">
  <label for={id} class="sr-only">
    {label}
  </label>

  <div class="search-icon pointer-events-none absolute left-4 top-1/2 -translate-y-1/2">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>
  </div>

  <input
    id={id}
    data-search-input
    name="search"
    type="search"
    autocomplete="off"
    spellcheck="false"
    placeholder={placeholderText}
    class="search-input"
  />

  <button
    type="button"
    data-search-clear
    class="search-clear absolute right-3 top-1/2 hidden -translate-y-1/2"
    aria-label="Clear search"
  >
    Clear
  </button>
</div>

<style>
  .search-icon,
  .search-clear {
    color: var(--site-accent);
  }

  .search-input {
    width: 100%;
    padding: 0.75rem 4.5rem 0.75rem 2.75rem;
    border: 1px solid var(--site-control);
    border-radius: 0.5rem;
    background: var(--site-surface);
    color: var(--site-ink);
  }

  .search-input::placeholder {
    color: var(--site-muted);
    opacity: 1;
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-clear {
    padding: 0.25rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }

  .search-clear:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .search-input:focus-visible,
  .search-clear:focus-visible {
    outline: 2px solid var(--site-accent);
    outline-offset: 2px;
  }
</style>
