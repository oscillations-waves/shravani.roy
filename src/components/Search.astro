---
import type { CollectionEntry } from "astro:content";
import ArrowCard from "@components/ArrowCard.astro";
import SearchBar from "@components/SearchBar.astro";

type SearchEntry = CollectionEntry<"blog"> | CollectionEntry<"projects">;

type Props = {
  data: SearchEntry[];
  placeholderText?: string;
};

const {
  data = [],
  placeholderText = "Search posts and projects...",
} = Astro.props as Props;

const items = data.map((entry: SearchEntry) => {
  const tokens: string[] = [
    entry.collection,
    entry.slug,
    entry.data.title,
    entry.data.summary,
    ...(entry.data.tags ?? []),
  ];

  const searchText = tokens
    .filter((token: string) => token.length > 0)
    .join(" ")
    .toLowerCase();

  return {
    entry,
    searchText,
  };
});
---

<div class="flex flex-col" data-search-root>
  <SearchBar
    id="site-search"
    label="Search posts and projects"
    placeholderText={placeholderText}
  />

  <div
    data-search-meta
    class="mt-12 hidden text-sm uppercase text-black/60 dark:text-white/60"
  >
  </div>

  <ul data-search-results class="mt-3 hidden flex-col gap-3">
    {items.map(({ entry, searchText }) => (
      <li data-search-item data-search-text={searchText} hidden>
        <ArrowCard entry={entry} />
      </li>
    ))}
  </ul>

  <p
    data-search-empty
    class="mt-3 hidden text-sm text-black/60 dark:text-white/60"
  >
    No results found.
  </p>
</div>

<script>
  const roots = document.querySelectorAll("[data-search-root]");

  roots.forEach((root: Element) => {
    if (!(root instanceof HTMLElement)) {
      return;
    }

    if (root.dataset.searchReady === "true") {
      return;
    }

    root.dataset.searchReady = "true";

    const input = root.querySelector("[data-search-input]");
    const clearButton = root.querySelector("[data-search-clear]");
    const meta = root.querySelector("[data-search-meta]");
    const resultsList = root.querySelector("[data-search-results]");
    const emptyState = root.querySelector("[data-search-empty]");
    const items = Array.from(root.querySelectorAll("[data-search-item]"));

    if (!(input instanceof HTMLInputElement)) {
      return;
    }

    const normalize = (value: string): string => value.trim().toLowerCase();

    const render = (): void => {
      const query = normalize(input.value);
      const tokens = query
        .split(/\s+/)
        .filter((token: string) => token.length > 0);
      const shouldSearch = query.length >= 2;
      let visibleCount = 0;

      items.forEach((item: Element) => {
        if (!(item instanceof HTMLElement)) {
          return;
        }

        const searchText = item.dataset.searchText ?? "";
        const isMatch =
          shouldSearch &&
          tokens.every((token: string) => searchText.includes(token));

        item.hidden = !isMatch;

        if (isMatch) {
          visibleCount += 1;
        }
      });

      if (resultsList instanceof HTMLElement) {
        resultsList.classList.toggle(
          "hidden",
          !shouldSearch || visibleCount === 0
        );
        resultsList.classList.toggle("flex", shouldSearch && visibleCount > 0);
      }

      if (meta instanceof HTMLElement) {
        meta.classList.toggle("hidden", !shouldSearch);

        if (shouldSearch) {
          meta.textContent = `Found ${visibleCount} result${
            visibleCount === 1 ? "" : "s"
          } for '${input.value}'`;
        }
      }

      if (emptyState instanceof HTMLElement) {
        emptyState.classList.toggle(
          "hidden",
          !shouldSearch || visibleCount > 0
        );
      }

      if (clearButton instanceof HTMLElement) {
        clearButton.classList.toggle("hidden", input.value.length === 0);
      }
    };

    input.addEventListener("input", render);

    if (clearButton instanceof HTMLButtonElement) {
      clearButton.addEventListener("click", () => {
        input.value = "";
        input.focus();
        render();
      });
    }

    render();
  });
</script>
