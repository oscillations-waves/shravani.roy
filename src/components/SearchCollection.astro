---
import type { CollectionEntry } from "astro:content";
import SearchBar from "@components/SearchBar.astro";
import { withBase } from "@/lib/utils";

type BlogEntry = CollectionEntry<"blog">;
type ProjectEntry = CollectionEntry<"projects">;
type WorkEntry = CollectionEntry<"work">;

type SearchEntry = BlogEntry | ProjectEntry | WorkEntry;

type Props = {
  data: SearchEntry[];
  tags?: string[];
  entry_name?: string;
};

const {
  data = [],
  tags = [],
  entry_name = "items",
} = Astro.props as Props;

const toValidDate = (value: unknown): Date | null => {
  if (value instanceof Date) {
    return Number.isNaN(value.getTime()) ? null : value;
  }

  if (typeof value === "string" || typeof value === "number") {
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? null : date;
  }

  return null;
};

const formatDate = (value: unknown) => {
  const date = toValidDate(value);

  if (!date) {
    return "";
  }

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "2-digit",
    year: "numeric",
  }).format(date);
};

const formatDateRange = (start: unknown, end: unknown) => {
  const startLabel = formatDate(start);

  if (!end) {
    return startLabel;
  }

  if (typeof end === "string") {
    const normalized = end.toLowerCase();

    if (
      normalized === "present" ||
      normalized === "current" ||
      normalized === "now"
    ) {
      return `${startLabel} - Present`;
    }
  }

  const endLabel = formatDate(end);

  if (!startLabel && !endLabel) {
    return "";
  }

  if (!endLabel) {
    return startLabel;
  }

  return `${startLabel} - ${endLabel}`;
};

const getTitle = (entry: SearchEntry) => {
  if (entry.collection === "work") {
    return `${entry.data.role} · ${entry.data.company}`;
  }

  return entry.data.title;
};

const getSummary = (entry: SearchEntry) => {
  if (entry.collection === "work") {
    return entry.data.company;
  }

  return entry.data.summary;
};

const getDateLabel = (entry: SearchEntry) => {
  if (entry.collection === "work") {
    return formatDateRange(entry.data.dateStart, entry.data.dateEnd);
  }

  return formatDate(entry.data.date);
};

const getTags = (entry: SearchEntry) => {
  if (entry.collection === "work") {
    return [];
  }

  return entry.data.tags ?? [];
};

const getHref = (entry: SearchEntry) => {
  if (entry.collection === "work") {
    return "";
  }

  return withBase(`/${entry.collection}/${entry.id}`);
};

const items = data.map((entry) => {
  const title = getTitle(entry);
  const summary = getSummary(entry);
  const dateLabel = getDateLabel(entry);
  const entryTags = getTags(entry);
  const href = getHref(entry);

  const searchText = [
    entry.id,
    entry.collection,
    title,
    summary,
    dateLabel,
    ...entryTags,
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();

  return {
    entry,
    title,
    summary,
    dateLabel,
    tags: entryTags,
    href,
    searchText,
  };
});

const allTags =
  tags.length > 0
    ? tags
    : [...new Set(items.flatMap((item) => item.tags))].sort((a, b) =>
        a.localeCompare(b)
      );

const label = entry_name === "posts" ? "posts" : entry_name;
---

<div class="flex flex-col" data-search-root>
  <SearchBar
    id={`search-${label}`}
    label={`Search ${label}`}
  />

  {allTags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {allTags.map((tag : string) => (
        <button
          type="button"
          data-tag-button
          data-tag-value={tag.toLowerCase()}
          aria-pressed="false"
          class="tag-button"
        >
          {tag}
        </button>
      ))}
    </div>
  )}

  <div
    data-search-meta
    class="search-meta mt-8 hidden"
  >
  </div>

  {items.length > 0 ? (
    <ul data-search-list class="search-results mt-8" role="list">
      {items.map((item) => (
        <li
          data-search-item
          data-search-text={item.searchText}
          data-search-tags={item.tags.join(" ").toLowerCase()}
        >
          {item.href ? (
            <a
              href={item.href}
              class="result-row"
            >
              <div class="min-w-0">
                {item.dateLabel && (
                  <div class="result-date">
                    {item.dateLabel}
                  </div>
                )}

                <h2 class="result-title">
                  {item.title}
                </h2>

                {item.summary && (
                  <p class="result-summary">
                    {item.summary}
                  </p>
                )}

                {item.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {item.tags.map((tag: string) => (
                      <span class="result-tag">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke="currentColor"
                class="result-arrow"
                aria-hidden="true"
              >
                <path d="M5 12h14m-7-7 7 7-7 7" />
              </svg>
            </a>
          ) : (
            <article class="result-row">
              {item.dateLabel && (
                <div class="result-date">
                  {item.dateLabel}
                </div>
              )}

              <h2 class="result-title">
                {item.title}
              </h2>

              {item.summary && (
                <p class="result-summary">
                  {item.summary}
                </p>
              )}
            </article>
          )}
        </li>
      ))}
    </ul>
  ) : (
    <p class="result-summary mt-8">
      No {label} found.
    </p>
  )}
</div>

<style>
  .tag-button,
  .result-tag {
    border: 1px solid var(--site-rule);
    border-radius: 999px;
    color: var(--site-accent);
    font-size: 0.78rem;
  }

  .tag-button {
    padding: 0.25rem 0.75rem;
    border-color: var(--site-control);
  }

  .tag-button:hover,
  a.result-row:hover {
    background: var(--site-wash);
  }

  .tag-button[aria-pressed="true"] {
    border-color: var(--site-accent);
    background: var(--site-active);
  }

  .tag-button:focus-visible,
  a.result-row:focus-visible {
    outline: 2px solid var(--site-accent);
    outline-offset: 2px;
  }

  .search-meta,
  .result-date {
    color: var(--site-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
  }

  .search-meta {
    overflow-wrap: anywhere;
  }

  .search-results:has(> li:not([hidden])) {
    border-top: 1px solid var(--site-rule);
  }

  .result-row {
    display: block;
    padding: 1.15rem 0.75rem;
    border-bottom: 1px solid var(--site-rule);
  }

  a.result-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
  }

  .result-date {
    margin-bottom: 0.3rem;
    text-transform: uppercase;
  }

  .result-title {
    color: var(--site-ink);
    font-family: var(--site-heading-font);
    font-size: clamp(1.2rem, 2.65vw, 1.5rem);
    font-weight: 400;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .result-summary {
    color: var(--site-muted);
  }

  .result-row .result-summary {
    margin-top: 0.35rem;
  }

  .result-tag {
    padding: 0.1rem 0.55rem;
  }

  .result-arrow {
    color: var(--site-accent);
  }
</style>

<script>
  const roots = document.querySelectorAll("[data-search-root]");

  roots.forEach((root) => {
    if (root instanceof HTMLElement && root.dataset.searchReady === "true") {
      return;
    }

    if (!(root instanceof HTMLElement)) {
      return;
    }

    root.dataset.searchReady = "true";

    const input = root.querySelector("[data-search-input]");
    const clearButton = root.querySelector("[data-search-clear]");
    const meta = root.querySelector("[data-search-meta]");
    const items = Array.from(root.querySelectorAll("[data-search-item]"));
    const tagButtons = Array.from(root.querySelectorAll("[data-tag-button]"));

    if (!(input instanceof HTMLInputElement)) {
      return;
    }

    let activeTag = "";

      const normalize = (value: string): string => value.trim().toLowerCase();    

    const render = () => {
      const query = normalize(input.value);
      let visibleCount = 0;

      items.forEach((item) => {
        if (!(item instanceof HTMLElement)) {
          return;
        }

        const searchText = item.dataset.searchText ?? "";
        const itemTags = item.dataset.searchTags ?? "";

        const matchesQuery = query.length < 2 || searchText.includes(query);
        const matchesTag = !activeTag || itemTags.includes(activeTag);
        const isVisible = matchesQuery && matchesTag;

        item.hidden = !isVisible;

        if (isVisible) {
          visibleCount += 1;
        }
      });

      if (clearButton instanceof HTMLElement) {
        clearButton.classList.toggle("hidden", input.value.length === 0);
      }

      tagButtons.forEach((button) => {
        if (!(button instanceof HTMLElement)) {
          return;
        }

        const isActive = button.dataset.tagValue === activeTag;
        button.setAttribute("aria-pressed", String(isActive));
      });

      if (meta instanceof HTMLElement) {
        const shouldShowMeta = query.length >= 2 || activeTag.length > 0;

        meta.classList.toggle("hidden", !shouldShowMeta);

        if (shouldShowMeta) {
          const queryPart = query.length >= 2 ? ` for '${input.value}'` : "";
          const tagPart = activeTag ? ` in '${activeTag}'` : "";
          meta.textContent = `Showing ${visibleCount} result${visibleCount === 1 ? "" : "s"}${queryPart}${tagPart}`;
        }
      }
    };

    input.addEventListener("input", render);

    if (clearButton instanceof HTMLButtonElement) {
      clearButton.addEventListener("click", () => {
        input.value = "";
        input.focus();
        render();
      });
    }

    tagButtons.forEach((button) => {
      if (!(button instanceof HTMLElement)) {
        return;
      }

      button.addEventListener("click", () => {
        const value = button.dataset.tagValue ?? "";
        activeTag = activeTag === value ? "" : value;
        render();
      });
    });

    render();
  });
</script>
