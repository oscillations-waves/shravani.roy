---
import type { CollectionEntry } from "astro:content";
import SearchBar from "@components/SearchBar.astro";

type BlogEntry = CollectionEntry<"blog">;
type ProjectEntry = CollectionEntry<"projects">;
type WorkEntry = CollectionEntry<"work">;

type SearchEntry = BlogEntry | ProjectEntry | WorkEntry;

type SearchItem = {
  title: string;
  summary: string;
  dateLabel: string;
  tags: string[];
  href: string;
  searchText: string;
};

type Props = {
  data: SearchEntry[];
  tags?: string[];
  entry_name?: string;
};

const {
  data = [],
  tags = [],
  entry_name = "items",
} = Astro.props as Props;

const toValidDate = (value: unknown): Date | null => {
  if (value instanceof Date) {
    return Number.isNaN(value.getTime()) ? null : value;
  }

  if (typeof value === "string" || typeof value === "number") {
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? null : date;
  }

  return null;
};

const formatDate = (value: unknown): string => {
  const date = toValidDate(value);

  if (!date) {
    return "";
  }

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "2-digit",
    year: "numeric",
  }).format(date);
};

const formatDateRange = (start: unknown, end: unknown): string => {
  const startLabel = formatDate(start);

  if (!end) {
    return startLabel;
  }

  if (typeof end === "string") {
    const normalized = end.toLowerCase();

    if (
      normalized === "present" ||
      normalized === "current" ||
      normalized === "now"
    ) {
      return `${startLabel} - Present`;
    }
  }

  const endLabel = formatDate(end);

  if (!startLabel && !endLabel) {
    return "";
  }

  if (!endLabel) {
    return startLabel;
  }

  return `${startLabel} - ${endLabel}`;
};

const getTitle = (entry: SearchEntry): string => {
  if (entry.collection === "work") {
    return `${entry.data.role} · ${entry.data.company}`;
  }

  return entry.data.title;
};

const getSummary = (entry: SearchEntry): string => {
  if (entry.collection === "work") {
    return entry.data.company;
  }

  return entry.data.summary;
};

const getDateLabel = (entry: SearchEntry): string => {
  if (entry.collection === "work") {
    return formatDateRange(entry.data.dateStart, entry.data.dateEnd);
  }

  return formatDate(entry.data.date);
};

const getTags = (entry: SearchEntry): string[] => {
  if (entry.collection === "work") {
    return [];
  }

  return entry.data.tags ?? [];
};

const getHref = (entry: SearchEntry): string => {
  if (entry.collection === "work") {
    return "";
  }

  return `/${entry.collection}/${entry.slug}`;
};

const label = entry_name === "posts" ? "posts" : entry_name;
const searchId = `${label}-search`;

const items: SearchItem[] = data.map((entry: SearchEntry) => {
  const title = getTitle(entry);
  const summary = getSummary(entry);
  const dateLabel = getDateLabel(entry);
  const entryTags = getTags(entry);
  const href = getHref(entry);

  const searchText = [
    entry.collection,
    entry.slug,
    title,
    summary,
    dateLabel,
    ...entryTags,
  ]
    .filter((token): token is string => typeof token === "string" && token.length > 0)
    .join(" ")
    .toLowerCase();

  return {
    title,
    summary,
    dateLabel,
    tags: entryTags,
    href,
    searchText,
  };
});

const allTags: string[] =
  tags.length > 0
    ? tags
    : [...new Set(items.flatMap((item: SearchItem) => item.tags))].sort(
        (a: string, b: string) => a.localeCompare(b)
      );
---

<div class="flex flex-col" data-search-root>
  <SearchBar
    id={searchId}
    label={`Search ${label}`}
    placeholderText="What are you looking for?"
  />

  {allTags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {allTags.map((tag: string) => (
        <button
          type="button"
          data-tag-button
          data-tag-value={tag.toLowerCase()}
          class="rounded-full border border-black/15 px-3 py-1 text-xs text-black/70 hover:border-black/40 hover:text-black dark:border-white/20 dark:text-white/70 dark:hover:border-white/50 dark:hover:text-white"
        >
          {tag}
        </button>
      ))}
    </div>
  )}

  <div
    data-search-meta
    class="mt-8 hidden text-sm uppercase text-black/60 dark:text-white/60"
  >
  </div>

  {items.length > 0 ? (
    <ul data-search-list class="mt-8 flex flex-col gap-3">
      {items.map((item: SearchItem) => (
        <li
          data-search-item
          data-search-text={item.searchText}
          data-search-tags={item.tags.join(" ").toLowerCase()}
        >
          {item.href ? (
            <a
              href={item.href}
              class="group flex items-center gap-3 rounded-lg border border-black/15 p-4 transition-colors hover:bg-black/5 dark:border-white/20 hover:dark:bg-white/10"
            >
              <div class="w-full">
                {item.dateLabel && (
                  <div class="mb-2 text-sm uppercase text-black/50 dark:text-white/50">
                    {item.dateLabel}
                  </div>
                )}

                <div class="font-semibold text-black dark:text-white">
                  {item.title}
                </div>

                {item.summary && (
                  <p class="mt-1 text-sm text-black/70 dark:text-white/70">
                    {item.summary}
                  </p>
                )}

                {item.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {item.tags.map((tag: string) => (
                      <span class="rounded-full border border-black/10 px-2 py-0.5 text-xs text-black/60 dark:border-white/15 dark:text-white/60">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 stroke-current text-black/50 transition-colors group-hover:text-black dark:text-white/50 group-hover:dark:text-white"
                aria-hidden="true"
              >
                <line
                  x1="5"
                  y1="12"
                  x2="19"
                  y2="12"
                  class="translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100"
                />
                <polyline
                  points="12 5 19 12 12 19"
                  class="translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1"
                />
              </svg>
            </a>
          ) : (
            <article class="rounded-lg border border-black/15 p-4 dark:border-white/20">
              {item.dateLabel && (
                <div class="mb-2 text-sm uppercase text-black/50 dark:text-white/50">
                  {item.dateLabel}
                </div>
              )}

              <div class="font-semibold text-black dark:text-white">
                {item.title}
              </div>

              {item.summary && (
                <p class="mt-1 text-sm text-black/70 dark:text-white/70">
                  {item.summary}
                </p>
              )}
            </article>
          )}
        </li>
      ))}
    </ul>
  ) : (
    <p class="mt-8 text-black/70 dark:text-white/70">
      No {label} found.
    </p>
  )}
</div>

<script>
  const roots = document.querySelectorAll("[data-search-root]");

  roots.forEach((root: Element) => {
    if (!(root instanceof HTMLElement)) {
      return;
    }

    if (root.dataset.searchReady === "true") {
      return;
    }

    root.dataset.searchReady = "true";

    const input = root.querySelector("[data-search-input]");
    const clearButton = root.querySelector("[data-search-clear]");
    const meta = root.querySelector("[data-search-meta]");
    const items = Array.from(root.querySelectorAll("[data-search-item]"));
    const tagButtons = Array.from(root.querySelectorAll("[data-tag-button]"));

    if (!(input instanceof HTMLInputElement)) {
      return;
    }

    let activeTag = "";

    const normalize = (value: string): string => value.trim().toLowerCase();

    const render = (): void => {
      const query = normalize(input.value);
      const tokens = query
        .split(/\s+/)
        .filter((token: string) => token.length > 0);
      let visibleCount = 0;

      items.forEach((item: Element) => {
        if (!(item instanceof HTMLElement)) {
          return;
        }

        const searchText = item.dataset.searchText ?? "";
        const itemTags = item.dataset.searchTags ?? "";

        const matchesQuery =
          query.length < 2 ||
          tokens.every((token: string) => searchText.includes(token));
        const matchesTag = !activeTag || itemTags.includes(activeTag);
        const isVisible = matchesQuery && matchesTag;

        item.hidden = !isVisible;

        if (isVisible) {
          visibleCount += 1;
        }
      });

      if (clearButton instanceof HTMLElement) {
        clearButton.classList.toggle("hidden", input.value.length === 0);
      }

      tagButtons.forEach((button: Element) => {
        if (!(button instanceof HTMLElement)) {
          return;
        }

        const isActive = button.dataset.tagValue === activeTag;

        button.setAttribute("aria-pressed", String(isActive));
        button.classList.toggle("border-black/60", isActive);
        button.classList.toggle("text-black", isActive);
        button.classList.toggle("dark:border-white/70", isActive);
        button.classList.toggle("dark:text-white", isActive);
      });

      if (meta instanceof HTMLElement) {
        const shouldShowMeta = query.length >= 2 || activeTag.length > 0;

        meta.classList.toggle("hidden", !shouldShowMeta);

        if (shouldShowMeta) {
          const queryPart = query.length >= 2 ? ` for '${input.value}'` : "";
          const tagPart = activeTag ? ` in '${activeTag}'` : "";

          meta.textContent = `Showing ${visibleCount} result${
            visibleCount === 1 ? "" : "s"
          }${queryPart}${tagPart}`;
        }
      }
    };

    input.addEventListener("input", render);

    if (clearButton instanceof HTMLButtonElement) {
      clearButton.addEventListener("click", () => {
        input.value = "";
        input.focus();
        render();
      });
    }

    tagButtons.forEach((button: Element) => {
      if (!(button instanceof HTMLElement)) {
        return;
      }

      button.addEventListener("click", () => {
        const value = button.dataset.tagValue ?? "";
        activeTag = activeTag === value ? "" : value;
        render();
      });
    });

    render();
  });
</script>
