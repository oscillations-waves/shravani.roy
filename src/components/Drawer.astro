---
import { LINKS } from "@/consts"
import { withBase } from "../lib/utils"

const pathname = Astro.url.pathname.replace(/\/$/, "")

function getCurrent(href: string): "page" | "location" | undefined {
  if (href.includes("#")) return
  const destination = withBase(href).replace(/\/$/, "")
  if (pathname === destination) return "page"
  if (href !== "/" && pathname.startsWith(destination + "/")) return "location"
}
---

<div id="drawer" inert class="fixed inset-x-0 top-16 z-40 overflow-y-auto px-5 py-3 motion-safe:transition-[opacity,transform,visibility] md:hidden">
  <nav aria-label="Primary">
    <ul role="list">
      {LINKS.map((LINK) => (
        <li>
          <a href={withBase(LINK.HREF)} aria-current={getCurrent(LINK.HREF)} class="site-nav-link flex min-h-11 items-center py-2">
            {LINK.TEXT}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  #drawer {
    max-height: calc(100dvh - 4rem);
    border-bottom: 1px solid var(--site-rule);
  }

  #drawer[inert] {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-0.5rem);
  }

  li + li {
    border-top: 1px solid var(--site-rule);
  }
</style>
