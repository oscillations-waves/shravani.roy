---
import { SITE, LINKS } from "../consts"
import { withBase } from "../lib/utils"
import Container from "@components/Container.astro"

const pathname = Astro.url.pathname.replace(/\/$/, "")

function getCurrent(href: string): "page" | "location" | undefined {
  if (href.includes("#")) return
  const destination = withBase(href).replace(/\/$/, "")
  if (pathname === destination) return "page"
  if (href !== "/" && pathname.startsWith(destination + "/")) return "location"
}

---

<header id="header" class="fixed top-0 z-50 h-16 w-full">
  <Container size="lg">
    <div class="flex h-full items-center justify-between">
      <a href={withBase("/")} class="site-wordmark inline-flex min-h-11 items-center">
        {SITE.SHORT_NAME}
      </a>

      <nav aria-label="Primary" class="ml-auto hidden items-center gap-4 text-sm md:flex lg:gap-6">
        {LINKS.map((LINK) => (
          <a
            href={withBase(LINK.HREF)}
            aria-current={getCurrent(LINK.HREF)}
            class="site-nav-link inline-flex min-h-11 items-center whitespace-nowrap"
          >
            {LINK.TEXT}
          </a>
        ))}
      </nav>

      <div class="site-nav-actions -mr-2 flex items-center gap-px md:ml-5 md:border-l md:pl-3">
        <a href={withBase("/search")} aria-label="Search blog posts and projects" aria-current={getCurrent("/search")} class="site-nav-icon">
          <svg aria-hidden="true" class="size-full">
            <use href={`${withBase("/ui.svg")}#search`}></use>
          </svg>
        </a>

        <button id="header-theme-button" type="button" aria-label="Toggle light and dark theme" class="site-nav-icon">
          <svg aria-hidden="true" class="block size-full dark:hidden">
            <use href={`${withBase("/ui.svg")}#sun`}></use>
          </svg>
          <svg aria-hidden="true" class="hidden size-full dark:block">
            <use href={`${withBase("/ui.svg")}#moon`}></use>
          </svg>
        </button>

        <button id="header-drawer-button" type="button" aria-label="Menu" aria-expanded="false" aria-controls="drawer" class="site-nav-icon md:hidden">
          <svg aria-hidden="true" id="drawer-open" class="size-full">
            <use href={`${withBase("/ui.svg")}#menu`}></use>
          </svg>
          <svg aria-hidden="true" id="drawer-close" class="size-full">
            <use href={`${withBase("/ui.svg")}#x`}></use>
          </svg>
        </button>
      </div>
    </div>
  </Container>
</header>

<style is:global>
  #header,
  #drawer {
    background: var(--site-paper);
    color: var(--site-ink);
  }

  #header {
    border-bottom: 1px solid var(--site-rule);
  }

  .site-wordmark {
    color: var(--site-accent);
    font-family: var(--site-heading-font);
    font-size: 1.875rem;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .site-nav-link,
  .site-nav-icon {
    color: var(--site-muted);
  }

  .site-wordmark:hover,
  .site-nav-link:hover,
  .site-nav-link[aria-current] {
    color: var(--site-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }

  .site-nav-link[aria-current] {
    font-weight: 700;
    text-decoration-thickness: 2px;
  }

  .site-nav-actions {
    border-color: var(--site-rule);
  }

  .site-nav-icon {
    @apply size-11 rounded-full p-3;
    stroke: currentColor;
  }

  .site-nav-icon:is(:hover, [aria-current], [aria-expanded="true"]) {
    background: var(--site-wash);
    color: var(--site-accent);
  }

  .site-nav-icon[aria-current] {
    box-shadow: inset 0 0 0 1px var(--site-accent);
  }

  :is(.site-wordmark, .site-nav-link, .site-nav-icon):focus-visible {
    outline: 2px solid var(--site-accent);
    outline-offset: 2px;
  }

  #header-drawer-button > #drawer-open {
    @apply block;
  }

  #header-drawer-button > #drawer-close {
    @apply hidden;
  }

  #header-drawer-button[aria-expanded="true"] > #drawer-open {
    @apply hidden;
  }

  #header-drawer-button[aria-expanded="true"] > #drawer-close {
    @apply block;
  }
</style>

<script>
  function setDrawerOpen(open: boolean) {
    const drawer = document.getElementById("drawer")
    const drawerButton = document.getElementById("header-drawer-button")
    drawer?.toggleAttribute("inert", !open)
    drawerButton?.setAttribute("aria-expanded", String(open))
  }

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return
    const drawerButton = event.target.closest("#header-drawer-button")
    if (drawerButton) {
      setDrawerOpen(drawerButton.getAttribute("aria-expanded") !== "true")
    } else if (event.target.closest("#header a, #drawer a")) {
      setDrawerOpen(false)
    }
  })

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return
    const drawerButton = document.getElementById("header-drawer-button")
    if (drawerButton?.getAttribute("aria-expanded") === "true") {
      setDrawerOpen(false)
      drawerButton.focus()
    }
  })
</script>
