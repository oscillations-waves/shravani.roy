---
import { SITE, LINKS } from "../consts"
import { cn, withBase } from "../lib/utils"
const { pathname } = Astro.url
const subpath = pathname.match(/[^/]+/g)
import Container from "@components/Container.astro"

// On cream-backgrounded pages (about, blog) use dark header text so it's legible.
const onLightPage =
  pathname === withBase("/about") ||
  pathname.startsWith(withBase("/about/")) ||
  pathname === withBase("/blog") ||
  pathname.startsWith(withBase("/blog/")) ||
  pathname === withBase("/work") ||
  pathname.startsWith(withBase("/work/")) ||
  pathname === withBase("/career") ||
  pathname.startsWith(withBase("/career/")) ||
  pathname === withBase("/projects") ||
  pathname.startsWith(withBase("/projects/")) ||
  pathname === withBase("/ask")
const textColor = onLightPage ? "text-neutral-800 dark:text-white" : "text-white"
const strokeColor = onLightPage ? "stroke-neutral-800 dark:stroke-white" : "stroke-white"
const borderColor = onLightPage ? "border-neutral-800/30 dark:border-white/30" : "border-white/30"
const hoverBg = onLightPage ? "hover:bg-neutral-800/10 dark:hover:bg-white/10" : "hover:bg-white/10"
const activePillBg = onLightPage ? "bg-neutral-800/15 dark:bg-white/20" : "bg-white/20"

const iconButton = cn(
  "size-9 rounded-full p-2 items-center justify-center",
  "bg-transparent",
  hoverBg,
  textColor,
  strokeColor,
  "border",
  borderColor,
  "transition-colors duration-300 ease-in-out",
)
const isActive = (href: string) =>
  pathname === withBase(href) || "/" + subpath?.[0] === href
---

<header id="header" class="fixed top-0 w-full h-16 z-50 ">
  <Container size="md">
    <div class="relative h-full w-full">
      <div class="absolute left-0 top-1/2 -translate-y-1/2 flex gap-1 font-semibold">
        <a href={withBase("/")} class={cn("flex gap-1 hover:opacity-80 transition-opacity duration-300 ease-in-out", textColor)}>
          <svg class="size-6 fill-current">
            <use href={`${withBase("/brand.svg")}#brand`}></use>
          </svg>
          <div>
            {SITE.TITLE}
          </div>
        </a>
      </div>

    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
      <nav class="hidden md:flex items-center justify-center text-sm gap-1">
        {
          LINKS.map((LINK) => (
            <a
              href={withBase(LINK.HREF)}
              class={cn(
                "h-8 rounded-full px-3 flex items-center justify-center transition-colors duration-300 ease-in-out",
                textColor,
                isActive(LINK.HREF)
                  ? onLightPage
                    ? "bg-neutral-800/20 dark:bg-white/30"
                    : "bg-white/30"
                  : onLightPage
                    ? "hover:bg-neutral-800/10 dark:hover:bg-white/15"
                    : "hover:bg-white/15"
              )}
            >
              {LINK.TEXT}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="buttons absolute right-0 top-1/2 -translate-y-1/2 flex gap-1">
      <a href={withBase("/search")} aria-label={`Search blog posts and projects on ${SITE.TITLE}`} class={cn("hidden md:flex", iconButton, isActive("/search") && cn("pointer-events-none", activePillBg))}>
        <svg class="size-full">
          <use href={`${withBase("/ui.svg")}#search`}></use>
        </svg>
      </a>

      <button id="header-theme-button" aria-label={`Toggle light and dark theme`} class={cn("hidden md:flex", iconButton)}>
        <svg class="size-full block dark:hidden">
          <use href={`${withBase("/ui.svg")}#sun`}></use>
        </svg>
        <svg class="size-full hidden dark:block">
          <use href={`${withBase("/ui.svg")}#moon`}></use>
        </svg>
      </button>

      <button id="header-drawer-button" aria-label={`Toggle drawer open and closed`} class={cn("flex md:hidden", iconButton)}>
        <svg id="drawer-open" class="size-full">
          <use href={`${withBase("/ui.svg")}#menu`}></use>
        </svg>
        <svg id="drawer-close" class="size-full">
          <use href={`${withBase("/ui.svg")}#x`}></use>
        </svg>
      </button>
    </div>
  </div>
  </Container>
</header>

<style>
  #header-drawer-button > #drawer-open {
    @apply block;
  }

  #header-drawer-button > #drawer-close {
    @apply hidden;
  }

  #header-drawer-button.open > #drawer-open {
    @apply hidden;
  }

  #header-drawer-button.open > #drawer-close {
    @apply block;
  }
</style>

<script is:inline>
  function toggleDrawer() {
    const drawer = document.getElementById("drawer")
    const drawerButton = document.getElementById("header-drawer-button")
    drawer?.classList.toggle("open")
    drawerButton?.classList.toggle("open")
  }

  function initializeDrawerButton() {
    const drawerButton = document.getElementById("header-drawer-button")
    drawerButton?.addEventListener("click", toggleDrawer)
  }

  document.addEventListener("astro:after-swap", initializeDrawerButton)
  initializeDrawerButton()
</script>
