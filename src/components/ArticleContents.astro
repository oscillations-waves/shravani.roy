---
type Heading = { depth: number; slug: string; text: string }
type Section = { heading: Heading; subsections: Heading[] }

type Props = {
  headings: readonly Heading[]
}

const { headings } = Astro.props
const sections: Section[] = []
let parentSection: Section | undefined

for (const heading of headings) {
  if (heading.depth === 3 && parentSection) {
    parentSection.subsections.push(heading)
    continue
  }

  const section: Section = { heading, subsections: [] }
  sections.push(section)
  if (heading.depth === 2) parentSection = section
}
---

{sections.length > 0 && (
  <nav class="article-contents" aria-label="On this page">
    {["desktop", "mobile"].map((layout) => {
      const Panel = layout === "desktop" ? "div" : "details"
      const Title = layout === "desktop" ? "p" : "summary"

      return (
        <Panel class={`contents-${layout}`}>
          <Title class="contents-title">On this page</Title>
          <ul class="contents-list" role="list">
            {sections.map(({ heading, subsections }) => (
              <li>
                <a href={`#${encodeURIComponent(heading.slug)}`}>{heading.text}</a>
                {subsections.length > 0 && (
                  <ul role="list">
                    {subsections.map(({ slug, text }) => (
                      <li><a href={`#${encodeURIComponent(slug)}`}>{text}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </Panel>
      )
    })}
  </nav>
)}

<style>
  .article-contents {
    border: 1px solid var(--site-rule);
    border-radius: 0.5rem;
    background: var(--site-surface);
  }

  .contents-desktop {
    display: none;
  }

  .contents-title {
    padding: 0.75rem 1rem;
    color: var(--site-accent);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  summary.contents-title {
    min-block-size: 2.75rem;
    border-radius: 0.5rem;
    cursor: pointer;
  }

  .contents-list {
    padding: 0 0.5rem 0.5rem;
  }

  .contents-list ul {
    margin-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--site-rule);
    padding-inline-start: 0.375rem;
  }

  .contents-list a {
    display: flex;
    align-items: center;
    min-block-size: 2.75rem;
    border-radius: 0.25rem;
    padding: 0.375rem 0.5rem;
    color: var(--site-accent);
    font-size: 0.9375rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .contents-list > li > a {
    font-weight: 700;
  }

  .contents-list a:is(:hover, :focus-visible),
  summary.contents-title:hover {
    background: var(--site-wash);
  }

  .contents-list a:is(:hover, :focus-visible) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  :is(.contents-list a, summary.contents-title):focus-visible {
    outline: 2px solid var(--site-accent);
    outline-offset: -2px;
  }

  @media (min-width: 64rem) {
    .contents-desktop {
      display: block;
      max-block-size: max(5.5rem, calc(100dvh - var(--article-contents-top, 5.5rem) - 1.25rem));
      overflow-y: auto;
    }

    .contents-mobile {
      display: none;
    }

    .contents-list a {
      min-block-size: 2.25rem;
    }
  }
</style>
