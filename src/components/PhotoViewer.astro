---
import { withBase } from "@/lib/utils";

interface Props {
  id: string;
  label: string;
  photos: readonly {
    src: string;
    alt: string;
    width: number;
    height: number;
    caption: string;
  }[];
}

const { id, label, photos } = Astro.props;
---

<dialog id={id} class="photo-viewer" aria-label={label} data-photo-viewer>
  <button class="photo-viewer-close" type="button" data-photo-close>
    <svg aria-hidden="true" width="18" height="18" stroke="currentColor">
      <use href={`${withBase("/ui.svg")}#x`} />
    </svg>
    Close
  </button>

  <div class="photo-viewer-stage">
    {photos.map((photo, index) => (
      <img
        src={photo.src}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        loading="lazy"
        hidden={index !== 0}
        data-photo-slide
        data-caption={photo.caption}
      />
    ))}
  </div>

  <div class="photo-viewer-controls">
    <button type="button" data-photo-previous>Previous</button>
    <p class="photo-viewer-status" role="status" aria-atomic="true">
      <span data-photo-count>1 of {photos.length}</span>
      <span data-photo-caption>{photos[0]?.caption}</span>
    </p>
    <button type="button" data-photo-next>Next</button>
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLDialogElement>("[data-photo-viewer]").forEach((dialog) => {
    const slides = dialog.querySelectorAll<HTMLImageElement>("[data-photo-slide]");
    const count = dialog.querySelector("[data-photo-count]");
    const caption = dialog.querySelector("[data-photo-caption]");
    if (!slides.length || !count || !caption) return;

    let activeIndex = 0;
    let opener: HTMLButtonElement | undefined;
    let backdropPressed = false;

    const showPhoto = (index: number) => {
      slides[activeIndex].hidden = true;
      activeIndex = (index + slides.length) % slides.length;
      const photo = slides[activeIndex];
      photo.hidden = false;
      count.textContent = `${activeIndex + 1} of ${slides.length}`;
      caption.textContent = photo.dataset.caption ?? "";
    };

    const isBackdrop = (event: MouseEvent) => {
      if (event.target !== dialog) return false;
      const { left, top, right, bottom } = dialog.getBoundingClientRect();
      return event.clientX < left || event.clientX > right || event.clientY < top || event.clientY > bottom;
    };

    const triggers = document.querySelectorAll<HTMLButtonElement>(
      `[data-photo-index][aria-controls="${CSS.escape(dialog.id)}"]`,
    );
    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const index = Number(trigger.dataset.photoIndex);
        if (dialog.open || !slides[index]) return;
        opener = trigger;
        showPhoto(index);
        dialog.showModal();
      });
    });

    dialog.querySelector("[data-photo-previous]")?.addEventListener("click", () => showPhoto(activeIndex - 1));
    dialog.querySelector("[data-photo-next]")?.addEventListener("click", () => showPhoto(activeIndex + 1));
    dialog.querySelector("[data-photo-close]")?.addEventListener("click", () => dialog.close());

    dialog.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      showPhoto(activeIndex + (event.key === "ArrowLeft" ? -1 : 1));
    });

    dialog.addEventListener("pointerdown", (event) => {
      backdropPressed = isBackdrop(event);
    });
    dialog.addEventListener("click", (event) => {
      if (backdropPressed && isBackdrop(event)) dialog.close();
      backdropPressed = false;
    });
    dialog.addEventListener("close", () => {
      backdropPressed = false;
      opener?.focus({ preventScroll: true });
      opener = undefined;
    });
  });
</script>

<style>
  .photo-viewer {
    position: fixed;
    inset: 0;
    box-sizing: border-box;
    inline-size: min(calc(100% - 1.5rem), 38rem);
    max-inline-size: none;
    block-size: min(calc(100vh - 1.5rem), 42rem);
    block-size: min(calc(100dvh - 1.5rem), 42rem);
    max-block-size: none;
    margin: auto;
    padding: clamp(0.75rem, 3vw, 1.25rem);
    overflow: auto;
    border: 1px solid var(--site-rule);
    border-radius: 1rem;
    background: var(--site-surface);
    color: var(--site-ink);
    box-shadow: 0 1.5rem 4rem rgb(10 25 18 / 25%);
  }

  .photo-viewer[open] {
    display: grid;
    grid-template-rows: auto minmax(5rem, 1fr) auto;
    gap: 0.75rem;
  }

  .photo-viewer::backdrop {
    background: rgb(12 24 19 / 75%);
  }

  .photo-viewer button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-block-size: 2.75rem;
    padding-inline: 0.65rem;
    border: 1px solid var(--site-control);
    border-radius: 0.5rem;
    color: var(--site-accent);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .photo-viewer button:hover {
    border-color: var(--site-accent);
    background: var(--site-wash);
  }

  .photo-viewer-close {
    justify-self: end;
  }

  .photo-viewer-stage {
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--site-paper);
  }

  .photo-viewer-stage img {
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 0;
    object-fit: contain;
  }

  .photo-viewer-stage img[hidden] {
    display: none;
  }

  .photo-viewer-controls {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
  }

  .photo-viewer-status {
    color: var(--site-muted);
    font-size: 0.875rem;
    line-height: 1.3;
    text-align: center;
  }

  .photo-viewer-status span {
    display: block;
  }

  .photo-viewer-status [data-photo-count] {
    color: var(--site-ink);
    font-weight: 700;
  }
</style>
