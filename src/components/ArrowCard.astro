---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "@/lib/utils";

type Entry = CollectionEntry<"blog"> | CollectionEntry<"projects">;

type Props = {
  entry: Entry;
};

const { entry } = Astro.props as Props;

const href = `/${entry.collection}/${entry.id}`;
const dateLabel = formatDate(entry.data.date, `${entry.collection}/${entry.id}.date`);
---

<a
  href={href}
  class="group p-4 gap-3 flex items-center border rounded-lg hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 blend"
>
  <div class="w-full h-full group-hover:text-black group-hover:dark:text-white blend">
    <div class="flex flex-wrap gap-2">
      <div class="text-sm uppercase opacity-60">
        {dateLabel}
      </div>
    </div>

    <div class="font-semibold mt-3 text-black dark:text-white">
      {entry.data.title}
    </div>

    {"summary" in entry.data && (
      <div class="mt-1 text-sm opacity-75">
        {entry.data.summary}
      </div>
    )}
  </div>

  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="stroke-current group-hover:stroke-black group-hover:dark:stroke-white"
  >
    <line
      x1="5"
      y1="12"
      x2="19"
      y2="12"
      class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out"
    />
    <polyline
      points="12 5 19 12 12 19"
      class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out"
    />
  </svg>
</a>