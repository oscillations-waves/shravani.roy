---
import type { CollectionEntry } from "astro:content";
import { formatDate, toValidDate, withBase } from "@/lib/utils";

type Entry = CollectionEntry<"blog"> | CollectionEntry<"projects">;

type Props = {
  entry: Entry;
};

const { entry } = Astro.props as Props;

const href = withBase(`/${entry.collection}/${entry.id}`);
const dateSource = `${entry.collection}/${entry.id}.date`;
const publishedAt = toValidDate(entry.data.date, dateSource);
const dateLabel = formatDate(publishedAt, dateSource);
---

<a href={href} class="entry-card group">
  <div class="entry-content">
    <time datetime={publishedAt.toISOString()}>{dateLabel}</time>
    <h2>{entry.data.title}</h2>

    {"summary" in entry.data && (
      <p>{entry.data.summary}</p>
    )}
  </div>

  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <line
      x1="5"
      y1="12"
      x2="19"
      y2="12"
      class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out"
    />
    <polyline
      points="12 5 19 12 12 19"
      class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out"
    />
  </svg>
</a>

<style>
  .entry-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border: 1px solid var(--site-rule);
    border-radius: 0.5rem;
    padding: 1rem clamp(1rem, 3vw, 1.25rem);
    color: var(--site-ink);
    background: var(--site-surface);
    transition: background-color 150ms ease, border-color 150ms ease;
  }

  .entry-card:hover,
  .entry-card:focus-visible {
    border-color: var(--site-control);
    background: var(--site-wash);
  }

  .entry-content {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  time,
  svg {
    color: var(--site-accent);
  }

  time {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h2 {
    margin-top: 0.35rem;
    font-family: var(--site-heading-font);
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.2;
  }

  p {
    margin-top: 0.4rem;
    color: var(--site-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  svg {
    flex: none;
  }
</style>
