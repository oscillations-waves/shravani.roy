---
import { withBase } from "@/lib/utils";
import { streetPortrait, type PortraitPhoto } from "@/data/portraits";

type Props = {
  photo?: PortraitPhoto;
  viewerIndex?: number;
  loading?: "eager" | "lazy";
};

const { photo = streetPortrait, viewerIndex, loading = "eager" } = Astro.props;
---

<div class="portrait-stage">
  <figure class:list={["portrait", { "portrait-printed": photo.framed }]}>
    <img
      src={withBase(photo.src)}
      alt={photo.alt}
      width={photo.width}
      height={photo.height}
      loading={loading}
      fetchpriority={loading === "eager" ? "high" : undefined}
    />
    {viewerIndex !== undefined && (
      <button
        class="portrait-open"
        type="button"
        data-about-photo={viewerIndex}
        aria-label={`View photo of ${photo.alt}`}
        aria-haspopup="dialog"
        aria-controls="about-photo-dialog"
      >
        <span>View photo <span aria-hidden="true">&nearr;</span></span>
      </button>
    )}
  </figure>
</div>

<style>
  .portrait-stage {
    --portrait-mat: #a8ddd4;

    position: relative;
    justify-self: center;
    isolation: isolate;
  }

  :global(html.dark) .portrait-stage {
    --portrait-mat: #255c55;
  }

  .portrait-stage::before {
    position: absolute;
    inset: 5% -0.75rem 3%;
    z-index: -1;
    border-radius: 1.25rem;
    background: var(--portrait-mat);
    content: "";
    transform: rotate(-6deg);
  }

  .portrait {
    position: relative;
    width: min(59vw, 14.5rem);
    padding: 0.5rem 0.5rem 1.9rem;
    background: #fffdf7;
    box-shadow: 0 1px 2px #1113, 0 14px 26px #181c1926;
    transform: rotate(3deg);
  }

  .portrait.portrait-printed {
    padding: 0;
    background: transparent;
    box-shadow: none;
  }

  .portrait-open {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: end;
    padding: 0.42rem;
    cursor: zoom-in;
  }

  .portrait-open > span {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--site-rule);
    border-radius: 999px;
    background: var(--site-paper);
    color: var(--site-accent);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .portrait-open:hover > span,
  .portrait-open:focus-visible > span {
    border-color: var(--site-accent);
    background: var(--site-wash);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 42rem) {
    .portrait-stage::before {
      inset-inline: 0;
    }

    .portrait {
      width: clamp(10.5rem, 24vw, 16.5rem);
      margin-inline: 0.75rem;
      padding: 0.65rem 0.65rem 2.35rem;
    }
  }
</style>
