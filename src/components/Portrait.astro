---
import { withBase } from "@/lib/utils";
import { streetPortrait, type PortraitPhoto } from "@/data/portraits";

type Props = {
  photo?: PortraitPhoto;
  viewerIndex?: number;
  loading?: "eager" | "lazy";
  daisies?: boolean;
};

const { photo = streetPortrait, viewerIndex, loading = "eager", daisies = false } = Astro.props;
---

<div class="portrait-stage">
  <figure class:list={["portrait", { "portrait-printed": photo.framed }]}>
    <img
      src={withBase(photo.src)}
      alt={photo.alt}
      width={photo.width}
      height={photo.height}
      loading={loading}
      fetchpriority={loading === "eager" ? "high" : undefined}
    />
    {viewerIndex !== undefined && (
      <button
        class="portrait-open"
        type="button"
        data-photo-index={viewerIndex}
        aria-label={`View photo of ${photo.alt}`}
        aria-haspopup="dialog"
        aria-controls="about-photo-dialog"
      >
        <span>View photo <span aria-hidden="true">&nearr;</span></span>
      </button>
    )}
  </figure>
  {daisies && <span aria-hidden="true" class="portrait-daisies"></span>}
</div>

<style>
  .portrait-stage {
    position: relative;
    justify-self: center;
    isolation: isolate;
  }

  .portrait-stage::before {
    position: absolute;
    inset: 5% -0.75rem 3%;
    z-index: -1;
    border-radius: 1.25rem;
    background: var(--site-portrait-mat);
    content: "";
    transform: rotate(-6deg);
  }

  .portrait {
    position: relative;
    width: min(59vw, 14.5rem);
    padding: 0.5rem 0.5rem 1.9rem;
    background: #fff;
    box-shadow: 0 1px 2px #1113, 0 14px 26px rgb(0 0 0 / 15%);
    transform: rotate(3deg);
  }

  .portrait.portrait-printed {
    padding: 0;
    background: transparent;
    box-shadow: none;
  }

  .portrait-daisies {
    position: absolute;
    z-index: 1;
    inset-inline-start: -0.8rem;
    inset-block-end: 0.65rem;
    inline-size: 3.85rem;
    block-size: 2.85rem;
    pointer-events: none;
  }

  .portrait-daisies::before,
  .portrait-daisies::after {
    position: absolute;
    aspect-ratio: 1;
    background:
      radial-gradient(ellipse 16% 16% at center, var(--site-portrait-mat) 94%, transparent),
      radial-gradient(ellipse 12% 22% at 50% 22%, #fff 95%, transparent),
      radial-gradient(ellipse 12% 22% at 50% 78%, #fff 95%, transparent),
      radial-gradient(ellipse 22% 12% at 22% 50%, #fff 95%, transparent),
      radial-gradient(ellipse 22% 12% at 78% 50%, #fff 95%, transparent),
      radial-gradient(ellipse 14% 14% at 29% 29%, #fff 95%, transparent),
      radial-gradient(ellipse 14% 14% at 71% 29%, #fff 95%, transparent),
      radial-gradient(ellipse 14% 14% at 29% 71%, #fff 95%, transparent),
      radial-gradient(ellipse 14% 14% at 71% 71%, #fff 95%, transparent);
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 22%));
    content: "";
  }

  .portrait-daisies::before {
    inset-inline-start: 0;
    inset-block-end: 0;
    inline-size: 2.7rem;
    transform: rotate(-12deg);
  }

  .portrait-daisies::after {
    inset-inline-end: 0;
    inset-block-end: 0.9rem;
    inline-size: 1.8rem;
    transform: rotate(16deg);
  }

  .portrait-open {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: end;
    padding: 0.42rem;
    cursor: zoom-in;
  }

  .portrait-open > span {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--site-rule);
    border-radius: 999px;
    background: var(--site-paper);
    color: var(--site-accent);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .portrait-open:hover > span,
  .portrait-open:focus-visible > span {
    border-color: var(--site-accent);
    background: var(--site-wash);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 42rem) {
    .portrait-stage::before {
      inset-inline: 0;
    }

    .portrait {
      width: clamp(10.5rem, 24vw, 16.5rem);
      margin-inline: 0.75rem;
      padding: 0.65rem 0.65rem 2.35rem;
    }
  }
</style>
